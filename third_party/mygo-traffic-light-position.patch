+// SetTrafficLightPosition moves the window buttons of a window made with a
+// position, once it is open, and AppKit laying the title bar out again does
+// not put them back.
+func TestMoveTrafficLights(t *testing.T) {
+	w := newWindow(t, mygo.WindowOptions{Width: 400, Height: 240, TitleBarStyle: mygo.TitleBarHidden,
+		TrafficLightPosition: &mygo.Point{X: 18, Y: 23}})
+	if _, _, ok := trafficLights(w); !ok {
+		t.Skip("only macOS windows have traffic lights")
+	}
+	placed := func(x, y float64, when string) {
+		t.Helper()
+		eventually(t, fmt.Sprintf("the close button at (%v, %v) %s", x, y, when), func() bool {
+			gx, gy, _ := trafficLights(w)
+			return gx == x && gy == y
+		})
+	}
+	placed(18, 23, "in a new window")
+	w.SetTrafficLightPosition(18, 15)
+	placed(18, 15, "once moved up")
+	w.SetTrafficLightPosition(24, 29)
+	placed(24, 29, "once moved down and in")
+	w.Page().LoadHTML("<title>Moved</title>", "")
+	eventually(t, "the page's title", func() bool { return w.Title() == "Moved" })
+	placed(24, 29, "once the window takes the page's title")
+}
