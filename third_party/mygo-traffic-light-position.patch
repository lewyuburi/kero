+// SetTrafficLightPosition reaches the backend's window, after the position
+// the window was made with.
+func TestSetTrafficLightPosition(t *testing.T) {
+	w, fw := testWindow(t, WindowOptions{TitleBarStyle: TitleBarHidden, TrafficLightPosition: &Point{X: 18, Y: 23}})
+	if p := fw.Opts.TrafficLightPosition; p == nil || *p != (platform.Point{X: 18, Y: 23}) {
+		t.Fatalf("made with %v, want (18, 23)", p)
+	}
+	w.SetTrafficLightPosition(18, 15)
+	if p := fw.TrafficLights(); p != (platform.Point{X: 18, Y: 15}) {
+		t.Errorf("moved to %v, want (18, 15)", p)
+	}
+	w.SetTrafficLightPosition(24, 31)
+	if p := fw.TrafficLights(); p != (platform.Point{X: 24, Y: 31}) {
+		t.Errorf("moved again to %v, want (24, 31)", p)
+	}
+}
